GROQ_API_KEY="your-groq-api-key"

# Must match the JWT_SECRET in frontend/.env exactly — this is how this
# service trusts requests forwarded from the Next.js backend.
JWT_SECRET="your-shared-jwt-secret"

# Same database as frontend/.env's DATABASE_URL — frontend/prisma/schema.prisma
# owns the schema and migrations; this service only reads/writes rows in the
# existing User/Message tables through its own SQLAlchemy models (models.py).
DATABASE_URL="mysql://root:changeme@localhost:3306/CONCEPT"
