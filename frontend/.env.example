DATABASE_URL="mysql://root:changeme@localhost:3306/CONCEPT"

# NextAuth's own session/cookie encryption secret — unrelated to JWT_SECRET
# below. Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret"

# Must match the JWT_SECRET in backend/.env exactly — this app signs a JWT
# with it after verifying the browser's session, and the Python service
# verifies that signature before answering.
JWT_SECRET="your-shared-jwt-secret"

# Server-side only (no NEXT_PUBLIC_ prefix): the browser never talks to the
# Python service directly, only this app's own /api routes do.
PYTHON_API_URL="http://localhost:8000/api"
